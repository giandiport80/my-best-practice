  "Validation Codeigniter 3 with file": {
    "prefix": "ci3_validate_full",
    "body": [
      "protected function _validate(\\$rules)",
      "{",
      "    \\$this->load->library('form_validation');",
      "",
      "    \\$file_validation_errors = [];",
      "",
      "    foreach (\\$rules as \\$rule) {",
      "        if (isset(\\$rule[3]) && \\$rule[3] === true) {",
      "            \\$result = \\$this->validate_file(\\$rule[0], \\$rule[2]);",
      "            if (\\$result !== true) {",
      "                \\$file_validation_errors[\\$rule[0]] = \\$result[\\$rule[0]];",
      "            }",
      "        } else {",
      "            \\$this->form_validation->set_rules(\\$rule[0], \\$rule[1], \\$rule[2]);",
      "        }",
      "    }",
      "",
      "    if (\\$this->form_validation->run() && empty(\\$file_validation_errors)) {",
      "        return TRUE;",
      "    }",
      "",
      "    \\$data = [];",
      "    \\$data['error_class'] = \\$data['error_string'] = [];",
      "    \\$data['success'] = true;",
      "",
      "    foreach (\\$rules as \\$rule) {",
      "        if (form_error(\\$rule[0])) {",
      "            \\$data['error_class'][] = \\$rule[0];",
      "            \\$data['error_string'][] = strip_tags(form_error(\\$rule[0]));",
      "        }",
      "    }",
      "",
      "    foreach (\\$file_validation_errors as \\$rule_name => \\$errors) {",
      "        foreach (\\$errors as \\$error_msg) {",
      "            \\$data['error_class'][] = \\$rule_name;",
      "            \\$data['error_string'][] = \\$error_msg;",
      "        }",
      "    }",
      "",
      "    \\$data['success'] = false;",
      "    \\$data[\"message\"] = \"Periksa kembali kolom inputan anda\";",
      "    \\$data[\"errors\"] = true;",
      "",
      "    http_response_code(400);",
      "    header(\"Content-Type: application/json\");",
      "    echo json_encode(\\$data);",
      "    exit();",
      "}",
      ""
    ],
    "description": "Validation Codeigniter 3 with file"
  },
  "Custom validation file codeigniter 3": {
    "prefix": "ci3_validate_callback_file",
    "body": [
      "function validate_file(\\$rule_name, \\$rules)",
      "{",
      "    \\$this->load->library('upload');",
      "",
      "    \\$rules_array = explode('|', \\$rules);",
      "    \\$validation_errors = [];",
      "",
      "    \\$is_required = false;",
      "    \\$max_size = 0;",
      "    \\$min_size = 0;",
      "    \\$allowed_types = '';",
      "    \\$size_unit = 'kb';",
      "",
      "    foreach (\\$rules_array as \\$rule) {",
      "        if (strpos(\\$rule, 'required') !== false) {",
      "            \\$is_required = true;",
      "        }",
      "        if (strpos(\\$rule, 'max:') !== false) {",
      "            \\$max_size = (int) str_replace('max:', '', \\$rule);",
      "        }",
      "        if (strpos(\\$rule, 'min:') !== false) {",
      "            \\$min_size = (int) str_replace('min:', '', \\$rule);",
      "        }",
      "        if (strpos(\\$rule, 'ext:') !== false) {",
      "            \\$allowed_types = str_replace('ext:', '', \\$rule);",
      "        }",
      "        if (strpos(\\$rule, 'sizetype:') !== false) {",
      "            \\$size_unit = str_replace('sizetype:', '', \\$rule);",
      "        }",
      "    }",
      "",
      "    \\$max_size_bytes = \\$size_unit === 'mb' ? \\$max_size * 1024 * 1024 : \\$max_size * 1024;",
      "    \\$min_size_bytes = \\$size_unit === 'mb' ? \\$min_size * 1024 * 1024 : \\$min_size * 1024;",
      "",
      "    if (isset(\\$_FILES[\\$rule_name]) && \\$_FILES[\\$rule_name]['error'] != UPLOAD_ERR_NO_FILE) {",
      "        \\$file_size = \\$_FILES[\\$rule_name]['size'];",
      "",
      "        if (\\$file_size < \\$min_size_bytes) {",
      "            \\$validation_errors[] = 'Ukuran file ' . \\$rule_name . ' tidak boleh kurang dari ' . \\$min_size . ' ' . strtoupper(\\$size_unit) . '.';",
      "        }",
      "",
      "        if (\\$file_size > \\$max_size_bytes) {",
      "            \\$validation_errors[] = 'Ukuran file ' . \\$rule_name . ' tidak boleh lebih dari ' . \\$max_size . ' ' . strtoupper(\\$size_unit) . '.';",
      "        }",
      "",
      "        \\$file_ext = pathinfo(\\$_FILES[\\$rule_name]['name'], PATHINFO_EXTENSION);",
      "        \\$allowed_exts = array_map('trim', explode(',', \\$allowed_types));",
      "        if (!empty(\\$allowed_types) && !in_array(\\$file_ext, \\$allowed_exts)) {",
      "            \\$validation_errors[] = 'Tipe file ' . \\$rule_name . ' tidak diizinkan. Tipe file yang diperbolehkan: ' . implode(', ', \\$allowed_exts) . '.';",
      "        }",
      "    } else {",
      "        if (\\$is_required) {",
      "            \\$validation_errors[] = 'File ' . \\$rule_name . ' tidak boleh kosong.';",
      "        }",
      "    }",
      "",
      "    if (!empty(\\$validation_errors)) {",
      "        return [\\$rule_name => \\$validation_errors];",
      "    }",
      "",
      "    return true;",
      "}"
    ],
    "description": "Validation Codeigniter 3 upload files"
  },
