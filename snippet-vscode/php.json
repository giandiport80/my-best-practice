  "cidatatable": {
    "prefix": "ci3_datatable",
    "body": [
      "class Cuti_datatable extends CI_Model",
      "{",
      "",
      "    var \\$table         = 't_cuti';",
      "    var \\$column_order  = array('nama', 'divisi', 'jabatan', 'nama_jenis_izin');",
      "    var \\$column_search = array('nama', 'divisi', 'jabatan', 'nama_jenis_izin');",
      "    var \\$order         = array('tgl_mulai' => 'desc');",
      "",
      "    private function get_select()",
      "    {",
      "        \\$this->db->select('t_cuti.*');",
      "    }",
      "",
      "    private function get_join()",
      "    {",
      "        \\$this->db->join('m_status', \"m_status.id = t_cuti.status_id\");",
      "    }",
      "",
      "    private function _where()",
      "    {",
      "        // cuti: 1, izin: 2",
      "        \\$this->db->where(\"jenis_izin\", 1);",
      "",
      "        if (!in_array(userdata(\"id_level\"), [1, 2])) {",
      "            \\$this->db->where(\"user_id\", userdata(\"id\"));",
      "        }",
      "",
      "        \\$tgl_mulai = \\$this->input->post(\"tgl_mulai\");",
      "        \\$tgl_akhir = \\$this->input->post(\"tgl_akhir\");",
      "        if (\\$tgl_mulai && \\$tgl_akhir) {",
      "            \\$this->db->where('tgl_mulai >=', \\$tgl_mulai);",
      "            \\$this->db->where('tgl_akhir <=', \\$tgl_akhir);",
      "            \\$this->db->or_group_start()",
      "                ->where('tgl_mulai <=', \\$tgl_akhir)",
      "                ->where('tgl_akhir >=', \\$tgl_mulai)",
      "                ->group_end();",
      "        }",
      "",
      "        \\$status_id = \\$this->input->post(\"status_id\", true);",
      "        if (\\$status_id) {",
      "            \\$this->db->where(\"status_id\", \\$status_id);",
      "        }",
      "",
      "        \\$user_id = \\$this->input->post(\"user_id\", true);",
      "        if (\\$user_id) {",
      "            \\$this->db->where(\"user_id\", \\$user_id);",
      "        }",
      "",
      "        \\$jenis_izin_id = \\$this->input->post(\"jenis_izin_id\", true);",
      "        if (\\$jenis_izin_id) {",
      "            \\$this->db->where(\"jenis_izin_id\", \\$jenis_izin_id);",
      "        }",
      "    }",
      "",
      "    private function _get_datatables_query()",
      "    {",
      "        \\$this->get_select();",
      "        \\$this->db->from(\\$this->table);",
      "        \\$this->get_join();",
      "        \\$this->_where();",
      "",
      "        \\$i = 0;",
      "",
      "        foreach (\\$this->column_search as \\$item) // looping awal",
      "        {",
      "            if (\\$_POST['search']['value']) // jika datatable mengirimkan pencarian dengan metode POST",
      "            {",
      "",
      "                if (\\$i === 0) // looping awal",
      "                {",
      "                    \\$this->db->group_start();",
      "                    \\$this->db->like(\\$item, \\$_POST['search']['value']);",
      "                } else {",
      "                    \\$this->db->or_like(\\$item, \\$_POST['search']['value']);",
      "                }",
      "",
      "                if (count(\\$this->column_search) - 1 == \\$i)",
      "                    \\$this->db->group_end();",
      "            }",
      "            \\$i++;",
      "        }",
      "",
      "        if (isset(\\$_POST['order'])) {",
      "            \\$this->db->order_by(\\$this->column_order[\\$_POST['order']['0']['column']], \\$_POST['order']['0']['dir']);",
      "        } else if (isset(\\$this->order)) {",
      "            \\$order = \\$this->order;",
      "            \\$this->db->order_by(key(\\$order), \\$order[key(\\$order)]);",
      "        }",
      "    }",
      "",
      "    function get_datatables()",
      "    {",
      "        \\$this->_get_datatables_query();",
      "",
      "        if (\\$_POST['length'] != -1) {",
      "            \\$this->db->limit(\\$_POST['length'], \\$_POST['start']);",
      "        }",
      "",
      "        \\$query = \\$this->db->get();",
      "",
      "        return \\$query->result();",
      "    }",
      "",
      "    function count_filtered()",
      "    {",
      "        \\$this->_get_datatables_query();",
      "",
      "        \\$query = \\$this->db->get();",
      "        return \\$query->num_rows();",
      "    }",
      "",
      "    public function count_all()",
      "    {",
      "        \\$this->get_select();",
      "        \\$this->db->from(\\$this->table);",
      "        \\$this->get_join();",
      "        \\$this->_where();",
      "",
      "        return \\$this->db->count_all_results();",
      "    }",
      "",
      "    /**",
      "     * fungsi untuk kebutuhan print data",
      "     *",
      "     */",
      "    function get_raw_data()",
      "    {",
      "        \\$this->get_select();",
      "        \\$this->db->from(\\$this->table);",
      "        \\$this->get_join();",
      "        \\$this->_where();",
      "",
      "        \\$query = \\$this->db->get();",
      "",
      "        return \\$query->result();",
      "    }",
      "}",
      ""
    ],
    "description": "cidatatable"
  },
