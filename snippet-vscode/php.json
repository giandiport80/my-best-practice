  "Codeigniter 3 Upload file": {
    "prefix": "ci3_uploadfile_helper",
    "body": [
      "/**",
      " * Fungsi untuk mengunggah file dengan opsi konfigurasi.",
      " * Option max_size itu sudah dalam mb",
      " *",
      " * @param string \\$input_name Nama input file (dari form).",
      " * @param string \\$upload_path Lokasi folder untuk menyimpan file.",
      " * @param array \\$options Opsi tambahan: ['allowed_types' => [], 'max_size' => null, 'encrypt_name' => true].",
      " * @return array Hasil pengunggahan: ['status' => bool, 'data' => array|string]",
      " */",
      "function upload_file(\\$input_name, \\$upload_path, \\$options = [])",
      "{",
      "    \\$CI = &get_instance();",
      "    \\$CI->load->library('upload');",
      "",
      "    \\$defaults = [",
      "        'allowed_types' => [],",
      "        'max_size'      => null,",
      "        'encrypt_name'  => false,",
      "        'filename'      => '',",
      "        'prefix_filename' => ''",
      "    ];",
      "",
      "    \\$config = array_merge(\\$defaults, \\$options);",
      "",
      "    if (!is_dir(\\$upload_path)) {",
      "        return [",
      "            'success' => false,",
      "            'message' => 'Upload path tidak ditemukan'",
      "        ];",
      "    }",
      "",
      "    \\$config['upload_path']   = \\$upload_path;",
      "    \\$config['allowed_types'] = empty(\\$config['allowed_types']) ? '*' : implode('|', \\$config['allowed_types']);",
      "    if (!is_null(\\$config['max_size'])) {",
      "        \\$config['max_size'] = \\$config['max_size'] * 1024;",
      "    }",
      "",
      "    if (!empty(\\$config['encrypt_name'])) {",
      "        \\$config['encrypt_name'] = \\$config['encrypt_name'];",
      "    }",
      "",
      "    if (!empty(\\$config['filename'])) {",
      "        \\$config['file_name'] = \\$config['filename'];",
      "    } elseif (\\$config['encrypt_name']) {",
      "        \\$config['encrypt_name'] = true;",
      "    }",
      "",
      "    if (!empty(\\$config['prefix_filename'])) {",
      "        \\$file_data = \\$_FILES[\\$input_name];",
      "        \\$config['file_name'] = \\$config['prefix_filename'] . \\$file_data['name'];",
      "    }",
      "",
      "    \\$CI->upload->initialize(\\$config);",
      "",
      "    if (!\\$CI->upload->do_upload(\\$input_name)) {",
      "        return [",
      "            'success' => false,",
      "            'message'    => \\$CI->upload->display_errors('', '')",
      "        ];",
      "    } else {",
      "        return [",
      "            'success' => true,",
      "            'data'    => \\$CI->upload->data()",
      "        ];",
      "    }",
      "}"
    ],
    "description": "Codeigniter 3 Upload file"
  },
